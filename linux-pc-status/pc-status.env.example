# PC Status Linux Agent
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
PC_STATUS_DISCORD_WEBHOOK_URL="PASTE_DISCORD_WEBHOOK_URL_HERE"

# Friendly computer name shown in Discord
PC_STATUS_NAME="zima-server"

# Send a status card every 5 minutes
PC_STATUS_INTERVAL_SECONDS=300
PC_STATUS_NOTIFY_STATUS=true

# Screenshot the physical XFCE desktop every 30 minutes
PC_STATUS_SCREENSHOT_ENABLED=true
PC_STATUS_SCREENSHOT_INTERVAL_SECONDS=1800

# XFCE physical desktop is usually :0
PC_STATUS_DISPLAY=":0"

# Leave empty to use ~/.Xauthority for the service user
PC_STATUS_XAUTHORITY=""

PC_STATUS_NOTIFY_STARTUP=true
PC_STATUS_NOTIFY_SHUTDOWN=true
